[
    {
        "UpdateStageName": "Server Download",
        "UpdateSourcePlatform": "Windows",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://github.com/clover-moe/spearmint/releases/download/release-{{SpearmintVersion}}/spearmint-{{SpearmintVersion}}-windows.zip",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "UnzipUpdateSource": true,
        "OverwriteExistingFiles": true,
        "DeleteAfterExtract": true,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Move Server Files",
        "UpdateSourcePlatform": "Windows",
        "UpdateSource": "Executable",
        "UpdateSourceData": "powershell.exe",
        "UpdateSourceArgs": "-NoProfile -Command \"$d = Get-ChildItem -LiteralPath '{{$FullBaseDir}}' -Directory -Filter 'spearmint-*-windows' | Select-Object -First 1; if ($d) { Copy-Item -Path ($d.FullName + '\\*') -Destination '{{$FullBaseDir}}' -Recurse -Force; Remove-Item -LiteralPath $d.FullName -Recurse -Force }\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Server Download",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://github.com/clover-moe/spearmint/releases/download/release-{{SpearmintVersion}}/spearmint-{{SpearmintVersion}}-linux.tar.xz",
        "UpdateSourceArgs": "spearmint-linux.tar.xz",
        "UpdateSourceTarget": "{{$FullRootDir}}",
        "OverwriteExistingFiles": true,
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Extract Server Files",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd '{{$FullRootDir}}' && tar -xJf spearmint-linux.tar.xz -C '{{$FullBaseDir}}' --strip-components=1 >/dev/null 2>&1 && rm -f spearmint-linux.tar.xz >/dev/null 2>&1 && chmod +x '{{$FullBaseDir}}spearmint-server_x86_64'\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Game Data Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "SteamCMD",
        "UpdateSourceData": "2200",
        "UpdateSourceTarget": "{{$FullRootDir}}client",
        "ForceDownloadPlatform": "Windows",
        "UpdateSourceConditionSetting": "DisableDataDownload",
        "UpdateSourceConditionValue": "false",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Game Data Copy",
        "UpdateSourcePlatform": "Windows",
        "UpdateSource": "Executable",
        "UpdateSourceData": "powershell.exe",
        "UpdateSourceArgs": "-NoProfile -Command \"$src = '{{$FullRootDir}}client/baseq3'; if (Test-Path $src) { Copy-Item -Path ($src + '/pak*.pk3') -Destination '{{$FullBaseDir}}baseq3' -Force }; Remove-Item -LiteralPath '{{$FullRootDir}}client' -Recurse -Force -ErrorAction SilentlyContinue\"",
        "UpdateSourceConditionSetting": "DisableDataDownload",
        "UpdateSourceConditionValue": "false",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Game Data Copy",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"if [ -d '{{$FullRootDir}}client/baseq3' ]; then cp -f '{{$FullRootDir}}client/baseq3/'pak*.pk3 '{{$FullBaseDir}}baseq3/' >/dev/null 2>&1; fi; rm -rf '{{$FullRootDir}}client' >/dev/null 2>&1\"",
        "UpdateSourceConditionSetting": "DisableDataDownload",
        "UpdateSourceConditionValue": "false",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Server Config Download",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "https://raw.githubusercontent.com/trash-pandy/AMPTemplates/custom-templates/spearmintserver.cfg",
        "UpdateSourceArgs": "server.cfg",
        "UpdateSourceTarget": "{{$FullBaseDir}}baseq3",
        "OverwriteExistingFiles": false,
        "SkipOnFailure": true
    }
]
